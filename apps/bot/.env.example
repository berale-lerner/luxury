# apps/bot — service-level environment only.
# Never define these at the project level (CLAUDE.md, Operations + Railway warning in DESIGN.md).

# Connects as bot_user. Limited, column-level SELECT on public; no access to business.
DATABASE_URL=postgres://bot_user:CHANGE_ME@localhost:5432/luxury

# Verifies that an inbound webhook genuinely came from Telegram, on every request.
TELEGRAM_WEBHOOK_SECRET=

# Owned by this service. apps/admin has its own.
TELEGRAM_BOT_TOKEN=

PORT=3001
LOG_LEVEL=info
