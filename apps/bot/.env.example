# apps/bot — service-level environment only.
# Never define these at the project level (CLAUDE.md, Operations + Railway warning in DESIGN.md).
#
# Copy to apps/bot/.env.local for local development; that file is git-ignored
# and is where real tokens live.

# Connects as bot_user. Limited, column-level SELECT on public; no access to
# business. The port below is docker-compose.dev.yml, prepared by `pnpm dev:setup`.
DATABASE_URL=postgres://bot_user:dev_bot_pw@localhost:55433/luxury_dev

# Verifies that an inbound webhook genuinely came from Telegram, on every
# request. Any random string, 16+ characters — the same value is given to
# Telegram by scripts/set-telegram-webhook.mjs.
#   openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# From @BotFather. Owned by this service; apps/admin has its own.
TELEGRAM_BOT_TOKEN=

# Which provider answers guests: anthropic or gemini. Only the selected
# provider's key is required, but holding both means switching is one
# variable rather than a redeploy.
MODEL_PROVIDER=gemini

# Optional. Each adapter has a sensible default for its provider.
# MODEL_NAME=

# From console.anthropic.com.
ANTHROPIC_API_KEY=

# From aistudio.google.com/apikey.
GEMINI_API_KEY=

# Which agent's published prompt this service serves.
AGENT_KEY=guest

# Where the apartments are, as an IANA timezone name. The agent is told the
# local time in this zone, so "this evening" means the same thing to it as to
# the guest — the server itself runs somewhere else entirely.
TIMEZONE=Asia/Jerusalem

# MiniHotel, for the check_availability tool — optional as a group. Without
# it the agent is not offered the tool. The three credentials are
# all-or-nothing. Locally, use the sandbox's public test user
# (minihotel.readme.io/reference/ari-api) and the sandbox URL; production
# credentials never land on a local machine.
MINIHOTEL_USERNAME=
MINIHOTEL_PASSWORD=
MINIHOTEL_HOTEL_ID=
MINIHOTEL_RATE_CODE=USD
# Omit for production. Sandbox: https://sandbox.minihotel.cloud/gds
MINIHOTEL_ARI_URL=

PORT=3001
LOG_LEVEL=info
