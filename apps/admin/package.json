{
  "name": "@luxury/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "start": "node dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "build:web": "vite build",
    "dev:web": "vite",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "dev": "node --env-file=.env.local dist/dev-server.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@luxury/messaging": "workspace:*",
    "@luxury/shared": "workspace:*",
    "better-auth": "^1.7.3",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.3",
    "vite": "^8.2.2"
  },
  "main": "./dist/index.js"
