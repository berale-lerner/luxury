# apps/admin — service-level environment only.
# Never define these at the project level (CLAUDE.md, Operations + Railway warning in DESIGN.md).

# Connects as admin_user. Full access to public and business.
DATABASE_URL=postgres://admin_user:CHANGE_ME@localhost:5432/luxury

# Google sign-in via Better Auth. These credentials exist in this service only.
# Signing in is authentication; the allowlist table decides authorization.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# This service sends confirmations and reminders on a manager's trigger,
# so it holds its own copy of the channel credentials.
TELEGRAM_BOT_TOKEN=

PORT=3000
LOG_LEVEL=info
