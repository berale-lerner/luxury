# apps/admin — service-level environment only.
# Never define these at the project level (CLAUDE.md, Operations).
#
# Copy to apps/admin/.env.local for local development; that file is
# git-ignored and is where real secrets live.

# Connects as admin_user: every schema, business included. That reach is why
# the allowlist in front of it is the security boundary.
DATABASE_URL=postgres://admin_user:dev_admin_pw@localhost:55433/luxury_dev

# Google sign-in, from console.cloud.google.com. The authorised redirect URI
# is <PUBLIC_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs session cookies. 32+ characters:  openssl rand -hex 32
AUTH_SECRET=

# Public origin. Used for the OAuth callback and the cookie scope.
PUBLIC_URL=http://localhost:3000

# Sends the manager's own messages. Owned by this service; apps/bot has its own.
TELEGRAM_BOT_TOKEN=

PORT=3000
LOG_LEVEL=info

# ── Development only ────────────────────────────────────────────────────
# `pnpm dev:admin` runs a separate entry point that skips Google sign-in and
# claims this address instead. It still goes through the real guard, so the
# address has to be in admin_allowlist:
#
#   INSERT INTO public.admin_allowlist (email) VALUES ('you@example.com');
#
# That entry point is unreachable from what production runs, and a test
# enforces it. Nothing here needs switching off before deploying.
DEV_ADMIN_EMAIL=
