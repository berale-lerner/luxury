# apps/bot — local development.
#
# Copy to .env.local (git-ignored) and fill in. In Railway these are set per
# service, never at the project level (CLAUDE.md, DEPLOY.md).

# The local development database from docker-compose.dev.yml.
# Migrations run as the owner; the service connects as bot_user.
DATABASE_URL=postgres://bot_user:dev_bot_pw@localhost:55433/luxury_dev

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Any random string, 16+ characters. Telegram echoes it on every webhook
# request and the service compares it; this is the webhook's authentication.
# Generate one with:  openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# From console.anthropic.com.
ANTHROPIC_API_KEY=

# Which agent's published prompt this service serves.
AGENT_KEY=guest

PORT=3001
LOG_LEVEL=debug
