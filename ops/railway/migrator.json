{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile",
    "watchPatterns": ["migrations/**", "scripts/migrate.mjs"]
  },
  "deploy": {
    "startCommand": "node scripts/migrate.mjs",
    "numReplicas": 1,
    "restartPolicyType": "NEVER"
  }
}
