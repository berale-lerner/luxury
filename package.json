{
  "name": "luxury",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json --noEmit",
    "db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.test.yml down -v",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "vitest run",
    "test:permissions": "vitest run tests/permissions",
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf tests/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "pg": "^8.13.1",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
