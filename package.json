{
  "name": "luxury",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.tools.json --noEmit",
    "db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.test.yml down -v",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "vitest run",
    "test:permissions": "vitest run tests/permissions",
    "build": "tsc -b && pnpm --filter @luxury/admin build:web",
    "clean": "tsc -b --clean && rm -rf tests/*.tsbuildinfo",
    "dev:db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:publish": "node scripts/publish-prompt.mjs guest --url postgres://postgres:postgres@localhost:55433/luxury_dev",
    "dev:bot": "node --env-file=apps/bot/.env.local apps/bot/dist/index.js",
    "telegram:webhook": "node --env-file=apps/bot/.env.local scripts/set-telegram-webhook.mjs",
    "dev:admin": "pnpm --filter @luxury/admin build && pnpm --filter @luxury/admin dev"
  },
  "devDependencies": {
    "@luxury/messaging": "workspace:^",
    "@luxury/shared": "workspace:^",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "railway": "^3.11.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
